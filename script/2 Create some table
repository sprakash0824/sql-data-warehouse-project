/*
	=====================================================
	I want to create some table
	This is schema name = 'Bronze' 
	This is a data table name 'crm_cust_info'
	=====================================================
	Now i concate the Schema and Data Table name
	So this is the output (bronze.crm_cust_info)
	=====================================================
	And this is the DDL command

*/
CREATE TABLE bronze.crm_cust_info
(
	cst_id				INT,
	cst_key				NVARCHAR(50),
	cst_firstname		NVARCHAR(50),
	cst_lastname		NVARCHAR(50),
	cst_material_status NVARCHAR(50),
	cst_gendr			NVARCHAR(50),
	cst_create_dare		DATE
);

CREATE TABLE bronze.crm_prod_info
(
	prd_id		 INT,
	prd_key		 NVARCHAR(50),
	prd_nm		 NVARCHAR(50),
	prd_cost	 INT,
	prd_line	 NVARCHAR(50),
	prd_start_dt DATETIME,
	prd_emd_dt	 DATETIME
);

CREATE TABLE bronze.crm_sales_details
(
	sls_ord_num		NVARCHAR(50),
	sls_prd_key		NVARCHAR(50),
	sls_cust_id		INT,
	sls_order_dt    INT,
	sls_ship_dt		INT,
	sls_due_dt		INT,
	sls_sales	    INT,
	sls_quantity	INT,
	sls_price		INT
);

==============================================
/* Here comes the second Data source 
Since before this is schema name = 'Bronze' 
This is a data table name 'erp_cust_info'*/
==============================================

CREATE TABLE bronze.erp_cust_a101
(
	cid		NVARCHAR(50),
	cntry	NVARCHAR(50)
);

CREATE TABLE bronze.erp_cust_az12
(
	cid		NVARCHAR(50),
	b_date	DATE,
	gender	NVARCHAR(50)
);

CREATE TABLE bronze.erp_px_cat_g1v2
(
	id			NVARCHAR(50),
	cat			NVARCHAR(50),
	subcat		NVARCHAR(50),
	maintenance NVARCHAR(50)
);


